# For the LT22M with the checked OpenWrt SPL-family loader and fullflash layout.
# Not an OEM web updater image; keep the stock device unselected.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tuoshi_lt22m_fullflash=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_lt22m-wwand=y
CONFIG_PACKAGE_wwand-ncm=y
CONFIG_PACKAGE_luci-app-wwand=y
CONFIG_PACKAGE_luci-proto-wwand=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_LUCI_LANG_de=y
CONFIG_PACKAGE_luci-i18n-base-de=y
# luci-app-wwand does not currently ship a German translation.
