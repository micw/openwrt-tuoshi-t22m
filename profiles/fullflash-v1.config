# For the LT22M with the checked OpenWrt SPL-family loader and fullflash layout.
# Not an OEM web updater image; keep the stock device unselected.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tuoshi_lt22m_fullflash=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_lt22m-modem-ui=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_LUCI_LANG_de=y
CONFIG_PACKAGE_luci-i18n-base-de=y
CONFIG_PACKAGE_luci-i18n-ml352-de=y
