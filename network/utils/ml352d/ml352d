#!/bin/sh
# ML352/ASR RNDIS supervisor for OpenWrt. Only this process talks to its AT port.
# Status includes IP addresses; keep it root-only. Never log PIN, ICCID, IMSI or IMEI.

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

NAME=ml352d
RUN_DIR=/var/run/ml352
STATUS="$RUN_DIR/status.json"
LOCK="$RUN_DIR/at.lock"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"

config_load ml352
config_get_bool enabled modem enabled 1
config_get at_port modem at_port /dev/ttyUSB1
config_get netdev modem netdev eth1
config_get interface modem interface lte
config_get apn modem apn ''
config_get_bool roaming modem roaming 1

# These board-specific policies are fixed, not user-facing UCI options.
poll_interval=15
retry_interval=45
recovery_delay=600
recovery_cooldown=1800
recovery_window=86400
recovery_max_attempts=3
case "$apn" in *[!a-zA-Z0-9._-]*) logger -t "$NAME" 'Invalid APN characters'; exit 1;; esac
case "$interface:$netdev:$at_port" in *[!a-zA-Z0-9_./:-]*) logger -t "$NAME" 'Invalid interface/device characters'; exit 1;; esac
[ "$enabled" -eq 1 ] || exit 0

last_pdp=''
last_renew=0
last_config_check=0
status_failures=0
iccid=''
last_sim_poll=0
last_error=''

log() { logger -t "$NAME" "$*"; }

# stdout is serial data with CR removed. A single AT transaction takes ~2 seconds.
# The lock coordinates other ML352 tools; refuse to race with picocom.
# Some USB serial transactions keep the lock briefly after a reply: wait up to 5s.
at() {
    [ -c "$at_port" ] || return 1
    pidof picocom >/dev/null 2>&1 && return 1
    (
        timeout 5 flock 9 || exit 1
        local output ret
        output="$(printf '%s\r' "$@" | timeout 15 socat -T 2 - "$at_port,rawer,echo=0,b115200" 2>/dev/null)"
        ret=$?
        printf '%s\n' "$output" | tr -d '\r'
        return "$ret"
    ) 9>"$LOCK"
}

# Extract a response line of the form PREFIX: value, without exposing raw logs.
value() {
    local prefix="$1" text="$2"
    printf '%s\n' "$text" | sed -n "s/^${prefix}:[[:space:]]*//p" | head -n 1
}

# CID 1 is the managed PDP context; never accidentally use another SIM profile.
value_cid1() {
    local prefix="$1" text="$2"
    printf '%s\n' "$text" | sed -n "s/^${prefix}:[[:space:]]*1,[[:space:]]*//p" | head -n 1
}

# One SIM-identity request per minute. Return 2 only for explicit SIM absence;
# transient AT/serial failures must not erase a previously cached ICCID.
read_iccid() {
    local raw candidate rc
    raw="$(at 'AT+ICCID' 2>/dev/null)"
    rc=$?
    if printf '%s\n' "$raw" | grep -Eq '^\+CME ERROR:.*SIM not inserted|^\+CME ERROR: (10|310)$|^\+CPIN: SIM REMOVED'; then
        return 2
    fi
    [ "$rc" -eq 0 ] || return 1
    candidate="$(value '+ICCID' "$raw" | tr -d '[:space:]"' | tr 'a-f' 'A-F')"
    case "$candidate" in ''|*[!0-9A-F]*) return 1;; esac
    [ "${#candidate}" -ge 18 ] && [ "${#candidate}" -le 22 ] || return 1
    iccid="$candidate"
    return 0
}

valid_ip() {
    case "$1" in
        ''|*[!0-9.]*|.*|*..*|*.) return 1;;
    esac
    [ "$(printf '%s' "$1" | awk -F. '{print NF}')" -eq 4 ] || return 1
    printf '%s\n' "$1" | awk -F. '{for(i=1;i<=4;i++) if ($i=="" || $i>255) exit 1}'
}

# Boot, failsafe and sysupgrade use the WLAN LED; S96led gives it back to
# Wi-Fi after S95done. All three cellular LEDs belong to this service only.
led_enabled() {
    case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
        tuoshi,lt22m|tuoshi,lt22m-fullflash) return 0;;
        *) return 1;;
    esac
}

led_all_off() {
    led_enabled || return 0
    local led
    for led in 2g 3g 4g; do
        [ -d "/sys/class/leds/blue:mobile-${led%g}" ] || continue
        printf '%s\n' none > "/sys/class/leds/blue:mobile-${led%g}/trigger" 2>/dev/null || :
        printf '0\n' > "/sys/class/leds/blue:mobile-${led%g}/brightness" 2>/dev/null || :
    done
}

# The separate ucode worker supplies its own millisecond sleep primitive;
# this target's BusyBox sleep cannot accept a fractional second.
stop_chase() {
    [ -n "$chase_pid" ] || return 0
    kill "$chase_pid" 2>/dev/null || :
    wait "$chase_pid" 2>/dev/null || :
    chase_pid=''
}

led_update() {
    led_enabled || return 0
    local selected=''

    if [ "$sim_state" = absent ] || [ "$sim_state" = unavailable ]; then
        stop_chase
        led_all_off
        return 0
    fi

    # A steady RAT indicator means both the modem PDP and Linux DHCP are up.
    if [ "$registered" -eq 1 ] && [ -n "$pdp_ip" ] && [ "$dhcp_ip" = "$pdp_ip" ]; then
        stop_chase
        case "$rat" in gsm) selected=2g;; umts) selected=3g;; lte) selected=4g;; esac
        led_all_off
        [ -n "$selected" ] &&
            printf '1\n' > "/sys/class/leds/blue:mobile-${selected%g}/brightness" 2>/dev/null || :
        return 0
    fi

    if [ -z "$chase_pid" ] || ! kill -0 "$chase_pid" 2>/dev/null; then
        stop_chase
        /usr/bin/ucode /usr/libexec/ml352-led-chase.uc "$$" &
        chase_pid=$!
    fi
}

# netifd sets autostart=false even when this daemon calls down. Remember the
# owner in tmpfs so recovery can distinguish that from an operator's ifdown.
network_down_owned="$RUN_DIR/network-down-owned"
network_up() {
    [ "${ML352_NO_NETWORK:-0}" = 1 ] && return
    if ubus call "network.interface.$interface" up '{}' >/dev/null 2>&1; then
        rm -f "$network_down_owned"
    fi
}
network_down() {
    [ "${ML352_NO_NETWORK:-0}" = 1 ] && return
    if ubus call "network.interface.$interface" down '{}' >/dev/null 2>&1; then
        (umask 077; : > "$network_down_owned")
    fi
}
network_restart() {
    [ "${ML352_NO_NETWORK:-0}" = 1 ] && return
    # New netifd DHCP restart sends SIGHUP to udhcpc: fresh DHCPDISCOVER.
    ubus call "network.interface.$interface" restart '{}' >/dev/null 2>&1 || {
        ubus call "network.interface.$interface" down '{}' >/dev/null 2>&1 || :
        ubus call "network.interface.$interface" up '{}' >/dev/null 2>&1 || :
    }
}

write_status() {
    local tmp="$STATUS.$$"
    json_init
    json_add_string sim_state "$sim_state"
    # Sensitive: this file and directory are root-only; never send ICCID to syslog.
    json_add_string iccid "$iccid"
    json_add_boolean registered "$registered"
    json_add_string registration "$registration"
    json_add_string rat "$rat"
    json_add_string operator "$operator"
    json_add_string csq "$csq"
    json_add_string rssi_dbm "$rssi"
    json_add_string band "$band"
    json_add_string pdp_ip "$pdp_ip"
    json_add_string dhcp_ip "$dhcp_ip"
    json_add_string last_error "$last_error"
    json_add_int updated "$(date +%s)"
    json_dump > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$STATUS"
}

# Preserve documented band masks/preferences; change only roamingConfig field 6.
# The ninth read-only field is vendor-specific; the documented setter takes eight.
configure_roaming() {
    local raw fields oldifs
    raw="$(at 'AT*BAND?' 2>/dev/null)" || return 1
    fields="$(value '\*BAND' "$raw" | tr -d '[:space:]')"
    case "$fields" in ''|*[!0-9,]*) return 1;; esac
    oldifs="$IFS"; IFS=,; set -- $fields; IFS="$oldifs"
    [ "$#" -ge 8 ] || return 1
    [ "$6" = "$roaming" ] && return 0
    raw="$(at "AT*BAND=$1,$2,$3,$4,$5,$roaming,$7,$8" 2>/dev/null)" || return 1
    printf '%s\n' "$raw" | grep -qx 'OK' || return 1
    log "Roaming configuration changed to $roaming; modem radio may reset"
    return 2
}

configure_apn() {
    local raw current
    raw="$(at 'AT+CGDCONT?' 2>/dev/null)" || return 1
    current="$(value_cid1 '+CGDCONT' "$raw" | awk -F '"' 'NR==1 {print $4}')"
    [ "$apn" = "$current" ] && return 0
    raw="$(at "AT+CGDCONT=1,\"IP\",\"$apn\"" 2>/dev/null)" || return 1
    printf '%s\n' "$raw" | grep -qx 'OK' || return 1
    log 'APN configuration updated; radio reconnect required'
    return 2
}

# Configure the modem's own SIM-detect pin once at startup, not by polling SIM.
# A changed HOSCFG setting takes effect only after a full modem restart.
configure_hotswap() {
    local raw current desired
    desired='1,1'  # LT22M SIM detect is always enabled; high means inserted.
    raw="$(at 'AT+HOSCFG?' 2>/dev/null)" || return 1
    current="$(value '+HOSCFG' "$raw" | tr -d '[:space:]')"
    [ "$current" = "$desired" ] && return 0
    raw="$(at "AT+HOSCFG=$desired" 2>/dev/null)" || return 1
    printf '%s\n' "$raw" | grep -qx 'OK' || return 1
    log "Hardware SIM hot-swap setting changed to $desired; restarting modem once"
    return 2
}

init_modem() {
    [ -e "$at_port" ] || return 1
    configure_hotswap
    case "$?" in
        0) :;;
        2) network_down; at 'AT+CFUN=1,1' >/dev/null 2>&1; sleep 8; return 1;;
        *) last_error='hotswap_configuration_failed';;
    esac
    configure_roaming
    case "$?" in
        0) :;;
        2) network_down; sleep 8;;
        *) last_error='roaming_configuration_failed';;
    esac
    configure_apn
    case "$?" in
        0) :;;
        2) network_down; at 'AT+CFUN=0' >/dev/null 2>&1; at 'AT+CFUN=1' >/dev/null 2>&1; sleep 8;;
        *) last_error='apn_configuration_failed';;
    esac
    # Automatic RNDIS dial, but do not mistake RNDISCALL=1 for LTE registration.
    local r
    r="$(at 'AT+DIALMODE?' 2>/dev/null)" || return 1
    [ "$(value '+DIALMODE' "$r" | tr -d '[:space:]')" = 1 ] && at 'AT+DIALMODE=0' >/dev/null 2>&1
    return 0
}

# Only a sustained failure to register warrants a modem reset. Keep the attempt
# budget in tmpfs so procd reload/respawn cannot bypass it; a router reboot clears
# it. Uptime is monotonic across wall-clock/NTP changes.
offline_since=''
last_sim_ok=''
recovery_state="$RUN_DIR/recovery.state"
recover_registration() {
    local uptime unused now state autostart available reg answer
    local window_start=0 attempts=0 last_attempt=0 tmp
    read -r uptime unused < /proc/uptime || return 0
    now="${uptime%%.*}"
    case "$now" in ''|*[!0-9]*) return 0;; esac

    # Do not reboot for a missing SIM, a serial failure, a disabled interface,
    # or a valid registration with only PDP/DHCP trouble.
    if [ "$registered" -ne 0 ] || [ "$sim_state" != ready ] ||
       [ -z "$last_sim_ok" ] || [ $((now - last_sim_ok)) -lt 0 ] ||
       [ $((now - last_sim_ok)) -gt 90 ] ||
       [ "$(uci -q get network.$interface.disabled)" = 1 ] ||
       [ "$(uci -q get network.$interface.proto)" != dhcp ] ||
       [ "$(uci -q get network.$interface.device)" != "$netdev" ]; then
        offline_since=''
        return 0
    fi
    state="$(ubus call "network.interface.$interface" status 2>/dev/null)" || { offline_since=''; return 0; }
    autostart="$(printf '%s\n' "$state" | jsonfilter -e '@.autostart' 2>/dev/null)"
    available="$(printf '%s\n' "$state" | jsonfilter -e '@.available' 2>/dev/null)"
    if { [ "$autostart" != true ] && [ ! -f "$network_down_owned" ]; } ||
       [ "$available" != true ]; then
        offline_since=''
        return 0
    fi
    if [ -z "$offline_since" ] || [ "$now" -lt "$offline_since" ]; then
        offline_since="$now"
        return 0
    fi
    [ $((now - offline_since)) -ge "$recovery_delay" ] || return 0

    if [ -f "$recovery_state" ]; then
        read -r window_start attempts last_attempt < "$recovery_state" || return 0
        case "$window_start:$attempts:$last_attempt" in *[!0-9:]*|::*|:*:|:*) return 0;; esac
        [ -n "$window_start" ] && [ -n "$attempts" ] && [ -n "$last_attempt" ] || return 0
    fi
    if [ "$now" -lt "$window_start" ] || [ $((now - window_start)) -ge "$recovery_window" ]; then
        window_start="$now" attempts=0 last_attempt=0
    fi
    [ "$attempts" -lt "$recovery_max_attempts" ] || return 0
    [ "$last_attempt" -eq 0 ] || [ $((now - last_attempt)) -ge "$recovery_cooldown" ] || return 0

    # Recheck under the existing serial lock before a disruptive command.
    answer="$(at 'AT' 2>/dev/null)" || { offline_since=''; return 0; }
    printf '%s\n' "$answer" | grep -qx OK || { offline_since=''; return 0; }
    answer="$(at 'AT+CEREG?' 2>/dev/null)" || { offline_since=''; return 0; }
    reg="$(value '+CEREG' "$answer" | awk -F, 'NF>=2 {gsub(/ /,"",$2);print $2}')"
    case "$reg" in
        0|2|3|4) :;;
        *) offline_since=''; return 0;;
    esac
    # This is an attempt, even if USB disappears before CFUN can reply.
    attempts=$((attempts + 1))
    [ "$window_start" -ne 0 ] || window_start="$now"
    tmp="$recovery_state.$$"
    printf '%s %s %s\n' "$window_start" "$attempts" "$now" > "$tmp" &&
        chmod 600 "$tmp" && mv -f "$tmp" "$recovery_state" || {
        rm -f "$tmp"; offline_since=''; return 0;
    }
    offline_since="$now"
    log "No network registration for 10 minutes; restarting modem (attempt $attempts/$recovery_max_attempts)"
    network_down
    if at 'AT+CFUN=1,1' >/dev/null 2>&1; then
        last_error='modem_recovery_restart'
    else
        last_error='modem_recovery_command_failed'
        log 'Modem restart command failed; cooldown still applies'
    fi
    write_status
}

sim_state=unknown registered=0 registration=unknown rat=unknown operator='' csq='' rssi='' band='' pdp_ip='' dhcp_ip=''
chase_pid=''
trap 'stop_chase; led_all_off; exit 0' TERM INT
write_status
init_modem || last_error='modem_unavailable'

while :; do
    if [ ! -c "$at_port" ]; then
        sim_state=unavailable registered=0 registration=offline rat=unknown csq='' rssi='' band='' pdp_ip='' dhcp_ip=''
        iccid=''
        offline_since=''; last_sim_ok=''
        last_error='at_port_missing'; network_down; led_update; write_status; sleep "$poll_interval"; continue
    fi

    # HOSCFG handles the physical hot-swap. This single query both checks
    # SIM presence and refreshes ICCID, at most once per 60 seconds.
    now="$(date +%s)"
    if [ $((now - last_sim_poll)) -ge 60 ]; then
        last_sim_poll="$now"
        read_iccid
        case "$?" in
            0) sim_state=ready; read -r sim_uptime _ < /proc/uptime; last_sim_ok="${sim_uptime%%.*}";;
            2) sim_state=absent; iccid=''; last_sim_ok=''; offline_since='';;
            *) :;;  # Keep cache on a transient AT/serial failure.
        esac
    fi

    # Network status is polled independently; no SIM event causes a radio reset.
    response="$(at 'AT+CSQ' 'AT+CEREG?' 'AT^SYSINFO' 'AT+COPS?' 'AT+CGACT?' 'AT+CGPADDR' 'AT*BANDIND?' 2>/dev/null)"
    if [ "$?" -ne 0 ] || [ -z "$response" ]; then
        # SIM status may already have changed in this cycle. Never leave the
        # previous animation or steady LED active just because AT failed.
        offline_since=''
        last_error='at_port_busy_or_no_response'
        led_update; write_status; sleep "$poll_interval"; continue
    fi

    cereg="$(value '+CEREG' "$response")"
    new_registration="$(printf '%s' "$cereg" | awk -F, 'NF>=2 {gsub(/ /,"",$2);print $2}')"
    new_cgact="$(value_cid1 '+CGACT' "$response" | tr -d '[:space:]')"
    new_cgpaddr="$(value_cid1 '+CGPADDR' "$response")"
    invalid_status=0
    case "$new_registration" in ''|*[!0-9]*) invalid_status=1;; esac
    case "$new_registration" in
        1|5)
            case "$new_cgact" in
                0) :;;
                1) [ -n "$new_cgpaddr" ] || invalid_status=1;;
                *) invalid_status=1;;
            esac
            ;;
    esac
    if [ "$invalid_status" -eq 1 ]; then
        offline_since=''
        status_failures=$((status_failures + 1))
        if [ "$status_failures" -ge 3 ]; then
            registered=0 registration=unknown rat=unknown pdp_ip='' dhcp_ip=''
            netifd_up="$(ubus call "network.interface.$interface" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
            if [ -n "$last_pdp" ] || [ "$netifd_up" = true ]; then network_down; fi
            last_pdp=''
        fi
        # Also reconcile a newly observed absent SIM when an incomplete AT
        # batch has not yet reached the three-sample network-down threshold.
        last_error='at_incomplete_status'
        led_update; write_status; sleep "$poll_interval"; continue
    fi
    status_failures=0

    csq="$(value '+CSQ' "$response" | awk -F, '{gsub(/ /,"",$1);print $1}')"
    case "$csq" in ''|*[!0-9]*) csq=''; rssi='';; 99) rssi='';; *) rssi=$(( -113 + 2 * csq ));; esac
    registration="$new_registration"
    registered=0
    case "$registration" in 1|5) registered=1;; esac
    sysinfo="$(value '\^SYSINFO' "$response")"
    mode="$(printf '%s' "$sysinfo" | awk -F, '{gsub(/ /,"",$4);print $4}')"
    case "$mode" in 9) rat=lte;; 5) rat=umts;; 0) rat=none;; *) rat=unknown;; esac
    operator="$(value '+COPS' "$response" | awk -F '"' 'NF>1 {print $2}')"
    case "$operator" in *[!0-9]*) operator='';; esac
    band="$(value '\*BANDIND' "$response" | awk -F, '{gsub(/ /,"",$2);print $2}')"
    case "$band" in ''|*[!0-9]*) band='';; esac
    pdp_ip="$(printf '%s' "$new_cgpaddr" | awk -F '"' 'NF>1 {print $2}')"
    valid_ip "$pdp_ip" || pdp_ip=''
    [ "$new_cgact" = 1 ] && [ "$pdp_ip" != 0.0.0.0 ] || pdp_ip=''
    dhcp_ip="$(ip -4 -o addr show dev "$netdev" 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')"
    valid_ip "$dhcp_ip" || dhcp_ip=''

    # Radio resets can lose the configured roaming policy. Keep this network
    # policy check independent from the once-per-minute SIM identity query.
    now="$(date +%s)"
    if [ "$registered" -eq 0 ] && [ $((now - last_config_check)) -ge 90 ]; then
        last_config_check="$now"
        configure_roaming
        case "$?" in
            2) offline_since=''; network_down; last_pdp=''; sleep 8;;
            0) :;;
            *) last_error='roaming_check_failed';;
        esac
    fi

    if [ "$registered" -eq 1 ] && [ -n "$pdp_ip" ]; then
        last_error=''
        if [ "$last_pdp" != "$pdp_ip" ]; then
            log 'PDP IP changed; DHCP will obtain new lease'
            last_pdp="$pdp_ip"; last_renew=0
        fi
        now="$(date +%s)"
        netifd_up="$(ubus call "network.interface.$interface" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
        if [ "$netifd_up" != true ]; then
            network_up
            last_renew="$now"  # Allow DHCP some time to obtain its initial lease.
        elif [ "$dhcp_ip" != "$pdp_ip" ] && [ $((now - last_renew)) -ge "$retry_interval" ]; then
            last_renew="$now"
            network_restart  # Fresh DHCPDISCOVER, not a unicast lease renewal.
        fi
    else
        netifd_up="$(ubus call "network.interface.$interface" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
        if [ -n "$last_pdp" ] || [ "$netifd_up" = true ]; then network_down; fi
        last_pdp=''
        [ "$registered" -eq 1 ] && last_error='pdp_inactive' || last_error='not_registered'
    fi
    led_update
    write_status
    [ "$1" = --once ] && exit 0
    recover_registration
    sleep "$poll_interval"
done
