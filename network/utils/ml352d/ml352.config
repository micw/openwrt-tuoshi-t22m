config modem 'modem'
	option enabled '1'
	option at_port '/dev/ttyUSB1'
	option netdev 'eth1'
	option interface 'lte'
	# Empty APN asks the mobile network for its default; it is not read from the SIM.
	option apn ''
	option roaming '1'
	# Optional: IPv4 target known to answer ping through this APN.
	# A failed data-path probe may trigger one bounded RNDIS rebind per session.
	# Leave empty for private APNs without a suitable probe target.
	option recovery_probe_ip ''
