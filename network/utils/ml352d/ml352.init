#!/bin/sh /etc/rc.common
# Small ML352/ASR supervisor. The network interface remains managed by netifd.
USE_PROCD=1
START=95
STOP=10

start_service() {
    local enabled
    case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
        tuoshi,lt22m|tuoshi,lt22m-fullflash) ;;
        *) return 0;;
    esac
    enabled="$(uci -q get ml352.modem.enabled)"
    [ "$enabled" = 0 ] && return 0
    [ -x /usr/sbin/ml352d ] || return 1
    [ -x /usr/bin/socat ] || { logger -t ml352d 'Install socat first'; return 1; }
    procd_open_instance
    procd_set_param command /usr/sbin/ml352d
    # AT requests may spend 5s waiting for the lock plus up to 15s on USB.
    # Give the shell enough time to run its TERM trap before procd uses SIGKILL.
    procd_set_param term_timeout 30
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/config/ml352
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger ml352
}
